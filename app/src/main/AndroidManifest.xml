<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-first: the data stays on the phone and leaves it only through the backup file the
         user chooses. allowBackup is off, so there is nothing for data extraction rules to
         govern. The app asks for no permission itself, and never for INTERNET; the four in the
         merged manifest (wake lock, network state, boot completed, foreground service) come from
         WorkManager, which the widget library brings (merged manifest read on 2026-10-26; read it
         again when a library is added). -->
    <application
        android:name=".UrlaubsplanerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:ignore="DataExtractionRules"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.Urlaubsplaner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup screen of the home screen widget; Android starts it, so it has this one filter.
             Stays exported on purpose (parked item 11, 2026-11-13): the launcher starts it, and a
             launcher that cannot would drop the widget it is placing. The screen ends at once
             without a valid widget id and only changes the style of that one widget. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_setup_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The two home screen widgets, small (2x1) and big (4x2). The date and time broadcasts
             redraw them when the day changes; whether Android delivers them to a manifest receiver
             is not verified on a phone, so the provider's update period is the safety net. The
             small one keeps the receiver name of the one widget that came before.
             Not exported (parked item 11, 2026-11-13): every action here is sent by the system
             (the app widget service and the protected date, time and locale broadcasts), and
             such a receiver still gets them. Android's Glance guide declares its receiver the same
             way. To be confirmed on a phone: the widget is listed in the launcher, can be placed
             and still follows the date. -->
        <receiver
            android:name=".widget.UrlaubsplanerWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <receiver
            android:name=".widget.UrlaubsplanerBigWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label_big">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_big" />
        </receiver>

        <!-- Hands the calendar file to a calendar app, that one file only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Below Android 13 the system does not keep the app language; AppCompat does, with this. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
